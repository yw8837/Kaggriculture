  "formulas_and_semantics": {
    "match_outcome": "1.0 if candidate_money > opponent_money; 0.5 if candidate_money == opponent_money; 0.0 otherwise.",
    "paired_match_delta": "mean(candidate match outcome - control match outcome) over the exact paired cells.",
    "paired_money_delta": "mean(candidate_money - control_money) over the exact paired cells.",
    "candidate_absolute_margin": "mean(candidate_money - opponent_money) within each opponent lane.",
    "seed_cluster_bootstrap": "For each seed, mean paired match deltas across both seats and selected opponents; resample the 16 seed means with replacement for 10,000 draws using random seed 0; the 95% interval uses sorted draw indices ceil(0.025*draws)-1 and ceil(0.975*draws)-1.",
    "r7_p10": "Sorted x, h=(n-1)*0.10, j=floor(h), g=h-j; x[j]+g*(x[j+1]-x[j]), with the single endpoint when j+1 is absent.",
    "reserve_conservation": "For every raw candidate game: create_observed_units - release_observed_units == pending_end.",
    "causal_completion": "For every raw candidate game: release_observed_units == causal_completed_reserve_release_units.",
    "protected_action_vector_proof": "The frozen candidate starts with exact G1 bytes and adds one overlay. On protected cells, sell_suppressed_orders + release_orders == 0, protected_lane_action_diff == 0, and outside_allowed_action_diff == 0; therefore the overlay returns the exact G1 action vector. Candidate and opponent final rewards/money must also compare as identical IEEE-754 binary64 values.",
    "counter_source": "All counter verdicts are recomputed from every raw game candidate_metrics mapping; summary totals are cross-checked but never trusted as the verdict source.",
    "transition_limit": "The standard runner does not retain full official transitions. Conservation is independently recomputed from raw per-game counters and frozen source semantics; no claim of independently archived transition traces is made."
  },
